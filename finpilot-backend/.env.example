# FinPilot Environment Variables Configuration
# Copy this file to .env and configure the secrets.

# Database URL configuration (CockroachDB Cloud)
# Format: cockroachdb://<username>:<password>@<host>:<port>/<database>?sslmode=verify-full&sslrootcert=certs/root.crt
DATABASE_URL=cockroachdb://upinsane:<password>@arthsaathi-32571.j77.aws-ap-south-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full&sslrootcert=certs/root.crt

# JWT Authentication Config
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=supersecretjwtkeyplaceholderforlocaldevelopmentauthflow
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
