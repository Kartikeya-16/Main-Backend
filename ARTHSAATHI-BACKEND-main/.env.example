# FinPilot Environment Variables Configuration
# Copy this file to .env: cp .env.example .env

# Database URL configuration
# Local zero-setup SQLite (ready immediately for local testing & viva demo)
DATABASE_URL=sqlite:///./finpilot.db

# Option B: CockroachDB Cloud (uncomment and replace <password> when using cloud database)
# DATABASE_URL=cockroachdb://upinsane:<password>@arthsaathi-32571.j77.aws-ap-south-1.cockroachlabs.cloud:26257/defaultdb?sslmode=require

# JWT Authentication Config
JWT_SECRET_KEY=supersecretjwtkeyplaceholderforlocaldevelopmentauthflow
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma-separated list)
# When running frontend on another machine or IP, add that IP or domain here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# Microservice Target URLs inside Docker network
ML_SERVICE_1_URL=http://ml-service-1:8001
ML_SERVICE_2_URL=http://ml-service-2-translation:8002
SCHEME_SERVICE_URL=http://scheme-service-1:8003
ADVISOR_SERVICE_URL=http://advisor-service:8005

